# ==============================================================================
# DevPilot Configuration (.env.example)
# ==============================================================================

# Deployment Environment (development, production, test)
DEVPILOT_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Server Host & Port
DEVPILOT_API_HOST=127.0.0.1
DEVPILOT_API_PORT=8000

# LLM Provider & Model Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# LLM API Key (DO NOT commit real keys to version control)
LLM_API_KEY=your-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# Context limit configuration (v0.7 RAG)
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=20000

# Search parameters (v0.6)
DEFAULT_TOP_K=5
DEFAULT_MIN_SCORE=0.0

# AI Agent parameters (v0.8)
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=10
MAX_TOOL_RESULT_CHARACTERS=12000

# Safety & Timeout Controls (v2.6)
OPERATION_TIMEOUT=60.0
TEST_TIMEOUT=30.0
MAX_PROJECT_SIZE_MB=500.0

# Optional Custom Project Storage Location (defaults to .devpilot/projects.json)
# PROJECT_STORAGE_LOCATION=/path/to/custom/projects.json

