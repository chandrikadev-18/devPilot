# DevPilot LLM, RAG & AI Agent Configuration

# LLM Provider (e.g. groq)
LLM_PROVIDER=groq

# LLM Model Name
LLM_MODEL=openai/gpt-oss-120b

# LLM API Key (used by default provider or specify GROQ_API_KEY)
LLM_API_KEY=your-groq-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# Context limit configuration (v0.7 RAG)
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=20000

# Search parameters (v0.6)
DEFAULT_TOP_K=5
DEFAULT_MIN_SCORE=0.0

# AI Agent parameters (v0.8)
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=10
MAX_TOOL_RESULT_CHARACTERS=12000
